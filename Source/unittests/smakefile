#
# :ts=8
#
# CCTest -- functional unit tests (happy path).
# CCPanic -- validation / abort_func harness (forged handles, EBADF, ...).
#
# Flags: SCOPTIONS in this directory (keep Sc lines short).
# Link: slink with *.lnk -- amiga.lib only, no sc.lib.
# cc_start.o must be first on FROM (SLINK has no ENTRY; first hunk is PC).
#
# Requires cclib.library in LIBS: (parent smake install).
# Run from Source/unittests.
#

###############################################################################

CRT_OBJS = \
	cc_start.o \
	/crt/cc_entry.o \
	/crt/cc_crt.o \
	/stubs/math.o \
	/stubs/blocksize.o \
	/stubs/stdiowin.o \
	/stubs/nostdio.o \
	/stubs/cxamemset.o \
	/stubs/cxamemcpy.o

CCTEST_OBJS = \
	cctest_util.o \
	cctest_crt.o \
	cctest_string.o \
	cctest_mem.o \
	cctest_conv.o \
	cctest_ctype.o \
	cctest_heap.o \
	cctest_list.o \
	cctest_fmt.o \
	cctest_stdio.o \
	cctest_io.o \
	cctest_time.o \
	cctest_env.o \
	cctest_sort.o \
	cctest_dir.o \
	cctest_path.o \
	cctest_locale.o \
	cctest_wchar.o \
	cctest_break.o \
	cctest.o

CCPANIC_OBJS = \
	cctest_util.o \
	ccpanic_heap.o \
	ccpanic_stdio.o \
	ccpanic_io.o \
	ccpanic_dir.o \
	ccpanic.o

###############################################################################

all: CCTest CCPanic CCPthread

CCTest: $(CRT_OBJS) $(CCTEST_OBJS) CCTest.lnk
	slink with CCTest.lnk

CCPanic: $(CRT_OBJS) $(CCPANIC_OBJS) CCPanic.lnk
	slink with CCPanic.lnk

CCPTHREAD_OBJS = \
	/ccpthread/pthread.o \
	/ccpthread/pthread_sync.o \
	/ccpthread/psem.o \
	/ccpthread/pthread_startup.o

CCPthread: $(CRT_OBJS) cctest_util.o ccpthread_main.o $(CCPTHREAD_OBJS) CCPthread.lnk
	slink with CCPthread.lnk

clean:
	delete quiet CCTest CCPanic CCPthread CCTest.map CCPanic.map CCPthread.map \
		$(CCTEST_OBJS) $(CCPANIC_OBJS) ccpthread_main.o cc_start.o \
		/crt/cc_entry.o /crt/cc_crt.o \
		/stubs/math.o /stubs/blocksize.o /stubs/stdiowin.o /stubs/nostdio.o \
		/stubs/cxamemset.o /stubs/cxamemcpy.o \
		$(CCPTHREAD_OBJS)

test: CCTest CCPanic CCPthread
	CCTest
	CCPanic
	CCPthread nohold

###############################################################################

# Copy asm into cwd so SAS/C writes cc_start.o here for *.lnk.
cc_start.o: /crt/cc_start.asm
	copy /crt/cc_start.asm cc_start.asm
	asm -u cc_start.asm
	delete quiet cc_start.asm

/crt/cc_entry.o: /crt/cc_entry.c
	Sc OBJNAME $@ $<

# Extra idir=/ so private/ headers resolve from Source/
/crt/cc_crt.o: /crt/cc_crt.c /private/cc_build.h /private/cc_internal.h /private/cc_break.h
	Sc idir=/ OBJNAME $@ $<

/stubs/math.o: /stubs/math.c
	Sc OBJNAME $@ $<

/stubs/blocksize.o: /stubs/blocksize.c
	Sc OBJNAME $@ $<

/stubs/stdiowin.o: /stubs/stdiowin.c
	Sc OBJNAME $@ $<

/stubs/nostdio.o: /stubs/nostdio.c
	Sc OBJNAME $@ $<

/stubs/cxamemset.o: /stubs/cxamemset.c
	Sc OBJNAME $@ $<

/stubs/cxamemcpy.o: /stubs/cxamemcpy.c
	Sc OBJNAME $@ $<

cctest_util.o: cctest_util.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_crt.o: cctest_crt.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_string.o: cctest_string.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_mem.o: cctest_mem.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_conv.o: cctest_conv.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_ctype.o: cctest_ctype.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_heap.o: cctest_heap.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_list.o: cctest_list.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_fmt.o: cctest_fmt.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_stdio.o: cctest_stdio.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_io.o: cctest_io.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_time.o: cctest_time.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_env.o: cctest_env.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_sort.o: cctest_sort.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_dir.o: cctest_dir.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_path.o: cctest_path.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_locale.o: cctest_locale.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_wchar.o: cctest_wchar.c cctest_util.h
	Sc OBJNAME $@ $<

cctest_break.o: cctest_break.c cctest_util.h
	Sc OBJNAME $@ $<

cctest.o: cctest.c cctest_util.h
	Sc OBJNAME $@ $<

ccpanic.o: ccpanic.c cctest_util.h
	Sc OBJNAME $@ $<

ccpanic_heap.o: ccpanic_heap.c cctest_util.h
	Sc OBJNAME $@ $<

ccpanic_stdio.o: ccpanic_stdio.c cctest_util.h
	Sc OBJNAME $@ $<

ccpanic_io.o: ccpanic_io.c cctest_util.h
	Sc OBJNAME $@ $<

ccpanic_dir.o: ccpanic_dir.c cctest_util.h
	Sc OBJNAME $@ $<

ccpthread_main.o: ccpthread_main.c
	Sc nostkchk OBJNAME $@ $<

# No asm -u: object symbols are _cc_* to match __stdargs (unix.lib2 style).
/ccpthread/pthread_startup.o: /ccpthread/pthread_startup.asm
	copy /ccpthread/pthread_startup.asm pthread_startup.asm
	asm pthread_startup.asm
	copy pthread_startup.o /ccpthread/pthread_startup.o
	delete quiet pthread_startup.asm pthread_startup.o

/ccpthread/pthread.o: /ccpthread/pthread.c /ccpthread/cc_pthread.h
	Sc nostkchk idir=/ccpthread OBJNAME $@ /ccpthread/pthread.c

/ccpthread/pthread_sync.o: /ccpthread/pthread_sync.c /ccpthread/cc_pthread.h
	Sc nostkchk idir=/ccpthread OBJNAME $@ /ccpthread/pthread_sync.c

/ccpthread/psem.o: /ccpthread/psem.c /ccpthread/cc_pthread.h
	Sc nostkchk idir=/ccpthread OBJNAME $@ /ccpthread/psem.c

.PHONY: all clean test
