fmt.o: fmt.c private/cc_internal.h private/cc_ieee.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

time.o: time.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

env.o: env.c private/cc_internal.h cclib_funcs.h
