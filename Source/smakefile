###############################################################################
# CClib.library — shared libc via LVOs.  No sc.lib: OS APIs only (exec/dos/utility).
###############################################################################

NAME = cclib.library

###############################################################################

OPTIMIZE = optimize opttime
DEBUG = symbolflush noopt

###############################################################################

# nostartup, no sc.lib.  Include generated SDK headers + NDK.
CFLAGS = resopt idlen=64 comnest streq strmerge nostkchk \
	includedir=include includedir=/SDK/Include_H includedir=include: $(OPTIMIZE) debug=$(DEBUG) \
	params=register strsect=code mccons smallcode smalldata \
	unsignedchars nomultipleincludes structureequivalence \
	optimizescheduler noversion noicons memorysize=huge \
	stringsconst nostartup

# NOSTARTUP shared library: provide __XCEXIT in LibInit.c so SLINK does
# not auto-pull LIB:sc.lib for CRT exit.  FP goes through mathieeedoubbas
# (cc_ieee.c + SetupSTDIO mathbase) — no C `double` ops / softfloat.

LFLAGS = addsym smallcode smalldata noicons batch stripdebug

###############################################################################

OBJS = \
	StartUp.o \
	LibInit.o \
	cc_util.o \
	cc_ieee_lvo.o \
	cc_ieee.o \
	support.o \
	mem.o \
	string.o \
	list.o \
	heap.o \
	conv.o \
	sort.o \
	io.o \
	stdio.o \
	fmt.o \
	time.o \
	env.o \
	process.o

###############################################################################

all: $(NAME) unittests

$(NAME): $(OBJS)
	Sc $(LFLAGS) NOSTARTUP LINK TO $@ $(OBJS)

install: $(NAME)
	copy $(NAME) LIBS:

clean:
	delete $(NAME) $(NAME).debug $(NAME).map $(OBJS) all
	cd unittests && smake clean

version:
	bumprev $(VERSION) $(NAME)

unittests:
	cd unittests && smake all

.PHONY: install clean version unittests

###############################################################################

LibInit.o: LibInit.c private/cc_build.h Rev.h
	Sc $(CFLAGS) OBJNAME $@ $<

StartUp.o: StartUp.c private/cc_build.h private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

cc_util.o: cc_util.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

cc_ieee_lvo.o: cc_ieee_lvo.asm
	asm -u $<

cc_ieee.o: cc_ieee.c private/cc_internal.h private/cc_ieee.h
	Sc $(CFLAGS) OBJNAME $@ $<

support.o: support.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

mem.o: mem.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

string.o: string.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

list.o: list.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

heap.o: heap.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

conv.o: conv.c private/cc_internal.h private/cc_ieee.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

sort.o: sort.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

io.o: io.c private/cc_internal.h cclib_funcs.h
	Sc $(CFLAGS) OBJNAME $@ $<

stdio.o: stdio.c private/cc_internal.h cclib_funcs.h
