# :ts=8
#
###############################################################################
# cclib.library — shared libc via LVOs.
#
# Compiler flags live in SCOPTIONS (sc merges that file automatically).
# Keep Sc command lines short — long CFLAGS hit "option exceeds buffer size".
#
# Link with slink + CClib.lnk (not "sc ... link") so SAS/C libs are not
# appended after Library=/LIB=.  Integer mul/div helpers live in cc_cxutil.o
# (utility.library); SCOPTIONS has utillib for inline codegen.
# Do NOT use libcode — LibInit is called with A6=ExecBase; libcode would
# make near data A6-relative and LibInit would fail (OpenLibrary returns NULL).
###############################################################################

NAME = cclib.library

###############################################################################

OBJS = \
	LibInit.o \
	StartUp.o \
	cc_util.o \
	cc_cxutil.o \
	cc_ieee_lvo.o \
	cc_ieee.o \
	cc_locale.o \
	support.o \
	mem.o \
	string.o \
	list.o \
	heap.o \
	conv.o \
	sort.o \
	io.o \
	stdio.o \
	fmt.o \
	time.o \
	env.o \
	process.o \
	dirent.o \
	sleep.o

###############################################################################

all: $(NAME) unittests

$(NAME): $(OBJS) CClib.lnk
	slink with CClib.lnk

install: $(NAME)
	copy $(NAME) LIBS:
	avail flush >nil:

clean:
	delete $(NAME) $(NAME).debug $(NAME).map $(OBJS) all
	cd unittests && smake clean

version:
	bumprev $(VERSION) $(NAME)

unittests:
	cd unittests && smake all

.PHONY: install clean version unittests

###############################################################################

# SCOPTIONS in this directory supplies all Sc flags.
LibInit.o: LibInit.c private/cc_build.h Rev.h
	Sc OBJNAME $@ $<

StartUp.o: StartUp.c private/cc_build.h private/cc_internal.h cclib_funcs.h
	Sc OBJNAME $@ $<

cc_util.o: cc_util.c private/cc_internal.h cclib_funcs.h
	Sc OBJNAME $@ $<

cc_cxutil.o: cc_cxutil.c private/cc_internal.h
	Sc OBJNAME $@ $<

cc_ieee_lvo.o: cc_ieee_lvo.asm
	asm -u $<

cc_ieee.o: cc_ieee.c private/cc_internal.h private/cc_ieee.h
	Sc OBJNAME $@ $<

cc_locale.o: cc_locale.c private/cc_internal.h
	Sc OBJNAME $@ $<

support.o: support.c private/cc_internal.h cclib_funcs.h
