heap.o: heap.c private/cc_internal.h cclib_funcs.h
	Sc OBJNAME $@ $<

conv.o: conv.c private/cc_internal.h private/cc_ieee.h cclib_funcs.h
	Sc OBJNAME $@ $<

sort.o: sort.c private/cc_internal.h cclib_funcs.h
