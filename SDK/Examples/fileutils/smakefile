#
# :ts=8
#
# CClib SDK example — small Shell fileutils linked against cclib.library CRT.
#
# Build from this directory after installing cclib.library in LIBS:
#   smake
#
# CRT objects are compiled from ///Source (same recipe as unittests).
# Link: amiga.lib only — no sc.lib.  cc_start.o must be first on FROM.
# wc also links ccpthread objects (mbtowc + multi-file pthread_create).
#

###############################################################################

SRC = ///Source

CRT_OBJS = \
	cc_start.o \
	$(SRC)/crt/cc_entry.o \
	$(SRC)/crt/cc_crt.o \
	$(SRC)/stubs/math.o \
	$(SRC)/stubs/blocksize.o \
	$(SRC)/stubs/stdiowin.o \
	$(SRC)/stubs/nostdio.o \
	$(SRC)/stubs/cxamemset.o \
	$(SRC)/stubs/cxamemcpy.o

TOOLS = cat ls pwd echo true false wc

###############################################################################

all: $(TOOLS)

cat: $(CRT_OBJS) cat.o cat.lnk
	slink with cat.lnk

ls: $(CRT_OBJS) ls.o ls.lnk
	slink with ls.lnk

pwd: $(CRT_OBJS) pwd.o pwd.lnk
	slink with pwd.lnk

echo: $(CRT_OBJS) echo.o echo.lnk
	slink with echo.lnk

true: $(CRT_OBJS) true.o true.lnk
	slink with true.lnk

false: $(CRT_OBJS) false.o false.lnk
	slink with false.lnk

CCPTHREAD_OBJS = \
	$(SRC)/ccpthread/pthread.o \
	$(SRC)/ccpthread/pthread_sync.o \
	$(SRC)/ccpthread/psem.o \
	$(SRC)/ccpthread/pthread_startup.o

wc: $(CRT_OBJS) wc.o $(CCPTHREAD_OBJS) wc.lnk
	slink with wc.lnk

clean:
	delete quiet cat ls pwd echo true false wc \
		cat.map ls.map pwd.map echo.map true.map false.map wc.map \
		cat.o ls.o pwd.o echo.o true.o false.o wc.o cc_start.o \
		$(SRC)/crt/cc_entry.o $(SRC)/crt/cc_crt.o \
		$(SRC)/stubs/math.o $(SRC)/stubs/blocksize.o $(SRC)/stubs/stdiowin.o $(SRC)/stubs/nostdio.o $(SRC)/stubs/cxamemset.o $(SRC)/stubs/cxamemcpy.o \
		$(CCPTHREAD_OBJS)

###############################################################################

cc_start.o: $(SRC)/crt/cc_start.asm
	copy $(SRC)/crt/cc_start.asm cc_start.asm
	asm -u cc_start.asm
	delete quiet cc_start.asm

$(SRC)/crt/cc_entry.o: $(SRC)/crt/cc_entry.c
	Sc OBJNAME $@ $<

$(SRC)/crt/cc_crt.o: $(SRC)/crt/cc_crt.c
	Sc idir=$(SRC) OBJNAME $@ $<

$(SRC)/stubs/math.o: $(SRC)/stubs/math.c
	Sc OBJNAME $@ $<

$(SRC)/stubs/blocksize.o: $(SRC)/stubs/blocksize.c
	Sc OBJNAME $@ $<

$(SRC)/stubs/stdiowin.o: $(SRC)/stubs/stdiowin.c
	Sc OBJNAME $@ $<

$(SRC)/stubs/nostdio.o: $(SRC)/stubs/nostdio.c
	Sc OBJNAME $@ $<

$(SRC)/stubs/cxamemset.o: $(SRC)/stubs/cxamemset.c
	Sc OBJNAME $@ $<

$(SRC)/stubs/cxamemcpy.o: $(SRC)/stubs/cxamemcpy.c
	Sc OBJNAME $@ $<

cat.o: cat.c
	Sc OBJNAME $@ $<

ls.o: ls.c
	Sc OBJNAME $@ $<

pwd.o: pwd.c
	Sc OBJNAME $@ $<

echo.o: echo.c
	Sc OBJNAME $@ $<

true.o: true.c
	Sc OBJNAME $@ $<

false.o: false.c
	Sc OBJNAME $@ $<

wc.o: wc.c
	Sc OBJNAME $@ $<

$(SRC)/ccpthread/pthread_startup.o: $(SRC)/ccpthread/pthread_startup.asm
	copy $(SRC)/ccpthread/pthread_startup.asm pthread_startup.asm
	asm pthread_startup.asm
	copy pthread_startup.o $(SRC)/ccpthread/pthread_startup.o
	delete quiet pthread_startup.asm pthread_startup.o

$(SRC)/ccpthread/pthread.o: $(SRC)/ccpthread/pthread.c $(SRC)/ccpthread/cc_pthread.h
	Sc nostkchk idir=$(SRC) idir=$(SRC)/ccpthread OBJNAME $@ $(SRC)/ccpthread/pthread.c

$(SRC)/ccpthread/pthread_sync.o: $(SRC)/ccpthread/pthread_sync.c $(SRC)/ccpthread/cc_pthread.h
	Sc nostkchk idir=$(SRC) idir=$(SRC)/ccpthread OBJNAME $@ $(SRC)/ccpthread/pthread_sync.c

$(SRC)/ccpthread/psem.o: $(SRC)/ccpthread/psem.c $(SRC)/ccpthread/cc_pthread.h
	Sc nostkchk idir=$(SRC) idir=$(SRC)/ccpthread OBJNAME $@ $(SRC)/ccpthread/psem.c

.PHONY: all clean
